# Runtime bytes come from the qualified wheel, not a second source build.
FROM python:3.13-alpine@sha256:9ef1a599f863231c3d91e941389bfdc4a2d6070557243d54df1a4e57015b960e AS build
WORKDIR /build
COPY --from=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5 /uv /usr/local/bin/uv
COPY requirements.txt ./
RUN uv venv /opt/edge && uv pip sync --python /opt/edge/bin/python --require-hashes requirements.txt
COPY private/ ./private/
COPY *.whl ./
RUN uv pip install --python /opt/edge/bin/python --no-deps private/*.whl ./*.whl && uv pip check --python /opt/edge/bin/python
COPY licenses/ ./licenses/
COPY prepare_notices.py ./
RUN /opt/edge/bin/python -I prepare_notices.py /opt/notices licenses
RUN /opt/edge/bin/python -I -c "from controlplane_edge.main import create_app; create_app()"

FROM python:3.13-alpine@sha256:9ef1a599f863231c3d91e941389bfdc4a2d6070557243d54df1a4e57015b960e
COPY --from=build /opt/edge /opt/edge
COPY --from=build /opt/notices /usr/share/doc/controlplane-edge/third-party
COPY LICENSE NOTICE /usr/share/doc/controlplane-edge/
ENV PATH=/opt/edge/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG GIT_SHA
ARG WHEEL_SHA256
LABEL org.opencontainers.image.licenses="Apache-2.0" org.opencontainers.image.source="https://github.com/hyperme-sh/controlplane-edge" org.opencontainers.image.revision=${GIT_SHA} sh.hyperme.qualified-wheel-sha256=${WHEEL_SHA256}
ENV GIT_SHA=${GIT_SHA} SERVICE_NAME=controlplane-edge
USER 65532:65532
EXPOSE 8000
CMD ["/opt/edge/bin/python", "-I", "-m", "controlplane_edge.main"]
